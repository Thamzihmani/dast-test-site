# ─── Fake WAF ────────────────────────────────────────────────────────────────
# Set to "true" to enable the fake WAF middleware.
# When ON: blocks obvious XSS payloads like <script>alert — tests fragmentationEnabled.
# When OFF: all payloads reach the endpoint directly.
ENABLE_FAKE_WAF=false

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Intentionally weak secret used by /api/auth/login and /api/jwt.
# DO NOT use this in real apps.
JWT_SECRET=secret

# ─── SSRF ────────────────────────────────────────────────────────────────────
# Max timeout (ms) for outbound SSRF fetch requests.
SSRF_TIMEOUT_MS=3000
